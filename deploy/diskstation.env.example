# Loaded inside the Memento container.
MEMENTO_ADMIN_MASTER_KEY=nenhuma

# Bootstrap/recovery credentials. Generate independent random values.
# The piclaw-workspace identity is imported as sandbox with admin during migration.
MEMENTO_TOKEN_WORKSPACE=replace-with-random-sandbox-bootstrap-token
MEMENTO_TOKEN_FLINT=replace-with-independent-flint-token
MEMENTO_TOKEN_WORK_AGENT=replace-with-independent-work-agent-token
