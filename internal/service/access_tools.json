  {
    "annotations": {
      "operation": "principal_create",
      "roles": [
        "admin"
      ]
    },
    "description": "Create a least-privilege principal and return its credential once for immediate secret-store capture. Required MCP params.arguments fields are `name`, `roles`, `read_prefixes`, `write_prefixes` and `idempotency_key`. Prefixes are namespace paths such as `/skills/`, never `memory://` resource URIs; every write prefix must be inside a read prefix.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "idempotency_key": {
          "description": "Durable retry key for this operation.",
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "description": "Lowercase letters, digits and hyphens; begin with a letter or digit.",
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "type": "string"
        },
        "read_prefixes": {
          "description": "Namespace paths, not memory:// resource URIs.",
          "items": {
            "description": "Namespace path beginning and ending with '/', such as '/skills/'.",
            "pattern": "^/(?:.*/)?$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "roles": {
          "description": "One or more managed roles.",
          "items": {
            "enum": [
              "reader",
              "proposer",
              "curator",
              "admin"
            ],
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "write_prefixes": {
          "description": "Namespace paths, not memory:// resource URIs.",
          "items": {
            "description": "Namespace path beginning and ending with '/', such as '/skills/'.",
            "pattern": "^/(?:.*/)?$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "name",
        "roles",
        "read_prefixes",
        "write_prefixes",
        "idempotency_key"
      ],
      "type": "object"
    },
    "name": "access_principal_create"
  },
