{
  "cases": [
    {
      "expected": {
        "id": 1,
        "jsonrpc": "2.0",
        "result": {
          "capabilities": {
            "completions": {},
            "logging": {},
            "prompts": {
              "get": true,
              "listChanged": true
            },
            "resources": {
              "listChanged": true,
