  "cases": [
    {
      "expected": {
        "error": {
          "code": -32602,
          "message": "Missing 'name' parameter"
        },
        "id": 1,
        "jsonrpc": "2.0"
      },
      "request": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/call\", \"params\": {}}",
      "transport": "stdio"
    },
    {
      "expected": {
        "error": {
          "code": -32601,
          "message": "Tool not found: missing"
        },
        "id": 1,
        "jsonrpc": "2.0"
      },
      "request": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/call\", \"params\": {\"name\": \"missing\"}}",
      "transport": "stdio"
    },
    {
      "expected": {
        "id": 1,
        "jsonrpc": "2.0",
        "result": {
          "content": [
            {
              "text": "pong",
              "type": "text"
            }
          ]
        }
      },
      "request": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/call\", \"params\": {\"name\": \"ping\"}}",
      "transport": "stdio"
    },
    {
      "expected": {
        "id": 1,
        "jsonrpc": "2.0",
        "result": {
          "content": [
            {
              "text": "hello ☃",
              "type": "text"
            }
          ]
        }
      },
      "request": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/call\", \"params\": {\"name\": \"echo\", \"arguments\": {\"text\": \"hello \\u2603\"}}}",
      "transport": "stdio"
    },
    {
      "expected": {
        "id": 1,
        "jsonrpc": "2.0",
        "result": {
          "content": [
            {
              "text": "5",
              "type": "text"
            }
          ],
          "structuredContent": 5
        }
      },
      "request": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/call\", \"params\": {\"name\": \"add\", \"arguments\": {\"a\": \"4\"}}}",
      "transport": "stdio"
    },
    {
      "expected": {
        "id": 1,
        "jsonrpc": "2.0",
        "result": {
          "content": [
            {
              "text": "7",
              "type": "text"
            }
          ],
          "structuredContent": 7
        }
      },
      "request": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/call\", \"params\": {\"name\": \"add\", \"arguments\": {\"a\": 5, \"b\": 2}}}",
      "transport": "stdio"
    },
    {
      "expected": {
        "error": {
          "code": -32603,
          "message": "Tool execution error for add: TypeError: can only concatenate str (not \"int\") to str"
        },
        "id": 1,
        "jsonrpc": "2.0"
      },
      "request": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/call\", \"params\": {\"name\": \"add\", \"arguments\": {\"a\": \"bad\"}}}",
      "transport": "stdio"
    },
    {
      "expected": {
        "error": {
          "code": -32602,
          "message": "Required parameter 'text' is missing"
        },
        "id": 1,
        "jsonrpc": "2.0"
      },
      "request": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/call\", \"params\": {\"name\": \"echo\", \"arguments\": {}}}",
      "transport": "stdio"
    },
    {
      "expected": {
        "error": {
          "code": -32602,
          "message": "Unrecognized parameter(s): a, z"
        },
        "id": 1,
        "jsonrpc": "2.0"
      },
      "request": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/call\", \"params\": {\"name\": \"ping\", \"arguments\": {\"z\": 1, \"a\": 2}}}",
      "transport": "stdio"
    },
    {
      "expected": {
        "id": 1,
        "jsonrpc": "2.0",
        "result": {
          "content": [
            {
              "text": "true",
              "type": "text"
            }
          ],
          "structuredContent": true
        }
      },
      "request": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/call\", \"params\": {\"name\": \"boolean\", \"arguments\": {\"flag\": \"YES\"}}}",
      "transport": "stdio"
    },
    {
      "expected": {
        "id": 1,
        "jsonrpc": "2.0",
        "result": {
          "content": [
            {
              "text": "false",
