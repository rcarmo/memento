# Container master key for managed access. Use a strong secret outside initial LAN bootstrap.
MEMENTO_ADMIN_MASTER_KEY=nenhuma

# Bootstrap/recovery credentials imported into control.sqlite on first managed-access startup.
# piclaw-workspace is migrated to the sandbox administrator identity.
MEMENTO_TOKEN_SANDBOX_BOOTSTRAP=replace-with-random-admin-bootstrap-token
MEMENTO_TOKEN_WORK_AGENT_BOOTSTRAP=replace-with-independent-work-agent-token

# Optional model-provider example variable referenced by examples/config.v1.json.
MEMENTO_OPENAI_API_KEY=

# Optional pure-Go model overrides. The release image already provides these paths.
MEMENTO_GTE_MODEL=/usr/local/share/memento/models/gte-small.gtemodel
MEMENTO_NEEDLE_MODEL=/usr/local/share/memento/models/memento-router.ndl
MEMENTO_NEEDLE_TOKENIZER=/usr/local/share/memento/models/needle.model
MEMENTO_SIMD=auto
