  "definitions": [
    {
      "annotations": {
        "operation": "propose",
        "roles": [
          "proposer"
        ]
      },
      "description": "Create a deterministic proposal from explicit changes.",
      "inputSchema": {
        "$defs": {
          "ProposeAssetChange": {
            "additionalProperties": false,
            "oneOf": [
              {
                "not": {
                  "required": [
                    "staged_asset_id"
                  ]
                },
                "required": [
                  "zip_base64"
                ]
              },
              {
                "not": {
                  "required": [
                    "zip_base64"
                  ]
                },
                "required": [
                  "staged_asset_id"
                ]
              }
            ],
            "properties": {
              "asset_kind": {
                "title": "Asset Kind",
                "type": "string"
              },
              "kind": {
                "const": "attach_asset_pack",
                "title": "Kind",
                "type": "string"
              },
              "path": {
                "title": "Path",
                "type": "string"
              },
              "staged_asset_id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Staged Asset Id"
              },
              "version": {
                "title": "Version",
                "type": "string"
              },
              "zip_base64": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Zip Base64"
              }
            },
            "required": [
              "kind",
              "path",
              "asset_kind",
              "version"
            ],
            "title": "ProposeAssetChange",
            "type": "object"
          },
          "ProposeCreateChange": {
            "additionalProperties": false,
            "properties": {
              "aliases": {
                "default": [],
                "items": {
                  "type": "string"
                },
                "title": "Aliases",
                "type": "array"
              },
              "body": {
                "title": "Body",
                "type": "string"
              },
              "concept_type": {
                "title": "Concept Type",
                "type": "string"
              },
              "description": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Description"
              },
              "kind": {
                "const": "create",
                "title": "Kind",
                "type": "string"
              },
              "path": {
                "title": "Path",
                "type": "string"
              },
              "tags": {
                "default": [],
                "items": {
                  "type": "string"
                },
                "title": "Tags",
                "type": "array"
              },
              "title": {
                "title": "Title",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "path",
              "concept_type",
              "title",
              "body"
            ],
            "title": "ProposeCreateChange",
            "type": "object"
          },
          "ProposePatchChange": {
            "additionalProperties": false,
            "properties": {
              "aliases": {
                "anyOf": [
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Aliases"
              },
              "body": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Body"
              },
              "description": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Description"
              },
              "kind": {
                "const": "patch",
                "title": "Kind",
                "type": "string"
              },
              "path": {
                "title": "Path",
                "type": "string"
              },
              "status": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Status"
              },
              "tags": {
                "anyOf": [
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Tags"
              },
              "title": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Title"
              }
            },
            "required": [
              "kind",
              "path"
            ],
            "title": "ProposePatchChange",
            "type": "object"
          },
          "ProposeRenameChange": {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "rename",
                "title": "Kind",
                "type": "string"
              },
              "new_path": {
                "title": "New Path",
                "type": "string"
              },
              "path": {
                "title": "Path",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "path",
              "new_path"
            ],
            "title": "ProposeRenameChange",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "base_revision": {
            "title": "Base Revision",
            "type": "string"
          },
          "changes": {
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ProposeCreateChange"
                },
                {
                  "$ref": "#/$defs/ProposePatchChange"
                },
                {
                  "$ref": "#/$defs/ProposeRenameChange"
                },
                {
                  "$ref": "#/$defs/ProposeAssetChange"
                }
              ]
            },
            "title": "Changes",
            "type": "array"
          },
          "intent": {
            "title": "Intent",
            "type": "string"
          },
          "rationale": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Rationale"
          }
        },
        "required": [
          "intent",
          "base_revision",
          "changes"
        ],
        "title": "_ProposeArgsSchema",
        "type": "object"
      },
      "name": "memory_propose",
      "parameters": [
        {
          "name": "intent",
          "required": true
        },
        {
          "name": "base_revision",
          "required": true
        },
        {
          "name": "changes",
          "required": true
        },
        {
          "default": null,
          "name": "rationale",
          "required": false
        }
      ]
    },
    {
      "annotations": {
        "operation": "proposal_get",
        "roles": [
          "proposer"
        ]
      },
      "description": "Read a bounded proposal summary or the detailed proposal record with per-change conflict metadata.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "proposal_id": {
            "title": "Proposal Id",
            "type": "string"
          },
          "view": {
            "default": "detailed",
            "enum": [
              "summary",
              "detailed"
            ],
            "title": "View",
            "type": "string"
          }
        },
        "required": [
          "proposal_id"
        ],
        "title": "ProposalGetArgs",
        "type": "object"
      },
      "name": "memory_proposal_get",
      "parameters": [
        {
          "name": "proposal_id",
          "required": true
        },
        {
          "default": "detailed",
          "name": "view",
          "required": false
        }
      ]
    },
    {
      "annotations": {
        "operation": "proposal_list",
        "roles": [
          "proposer"
        ]
      },
      "description": "List bounded, cursor-paginated summaries of visible proposal records.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Cursor"
          },
          "limit": {
            "default": 50,
            "maximum": 200,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Status"
          }
        },
        "title": "ProposalListArgs",
        "type": "object"
      },
      "name": "memory_proposal_list",
      "parameters": [
        {
          "default": null,
          "name": "status",
          "required": false
        },
        {
          "default": 50,
          "name": "limit",
          "required": false
        },
        {
          "default": null,
          "name": "cursor",
          "required": false
        }
      ]
    },
    {
      "annotations": {
        "operation": "proposal_asset_get",
        "roles": [
          "proposer"
        ]
      },
      "description": "Inspect staged proposal asset metadata or one bounded manifest-listed file.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "file_path": {
            "type": "string"
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "proposal_id": {
            "type": "string"
          }
        },
        "required": [
          "proposal_id",
          "asset_id"
        ],
        "type": "object"
      },
      "name": "memory_proposal_asset_get",
      "parameters": [
        {
          "name": "proposal_id",
          "required": true
        },
        {
          "name": "asset_id",
          "required": true
        },
        {
          "default": null,
          "name": "file_path",
          "required": false
        },
        {
          "default": 0,
          "name": "offset",
          "required": false
        },
        {
          "default": 65536,
          "name": "limit",
          "required": false
        }
      ]
    },
    {
      "annotations": {
        "operation": "proposal_rebase",
        "roles": [
          "proposer",
          "curator"
        ]
      },
      "description": "Rebase a clean proposal in place, retaining author and assets; original author or scoped curator, durable key required.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "expected_revision": {
            "title": "Expected Revision",
            "type": "string"
          },
          "idempotency_key": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Idempotency Key",
            "type": "string"
          },
          "proposal_id": {
            "title": "Proposal Id",
            "type": "string"
          }
        },
        "required": [
          "proposal_id",
          "expected_revision",
          "idempotency_key"
        ],
        "title": "ProposalRebaseArgs",
        "type": "object"
      },
      "name": "memory_proposal_rebase",
      "parameters": [
        {
          "name": "proposal_id",
          "required": true
        },
        {
          "name": "expected_revision",
          "required": true
        },
        {
          "name": "idempotency_key",
          "required": true
        }
      ]
    },
    {
      "annotations": {
        "operation": "proposal_revise",
        "roles": [
          "curator"
        ]
      },
      "description": "Create a follow-up proposal from a conflict-free subset of a stale proposal.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "expected_revision": {
            "type": "string"
          },
          "intent": {
            "type": "string"
          },
          "proposal_id": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "selected_change_indexes": {
            "type": "string"
          }
        },
        "required": [
          "proposal_id",
          "selected_change_indexes",
          "expected_revision"
        ],
